---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const posts=(await getCollection("posts",({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const dateFormat=new Intl.DateTimeFormat("en",{month:"short",day:"numeric",year:"numeric"});
---
<BaseLayout description="Notes, projects, and things worth keeping. A personal blog by adi.">
<section class="hero" id="top"><span class="eyebrow">A little corner of the internet</span><h1>Ideas, notes &<br/><span>everything between.</span></h1><p>Hey, I'm adi. This is where I put thoughts, things I'm building, lessons I've picked up, and the occasional rabbit hole.</p></section>
<section aria-labelledby="writing-title"><div class="section-heading"><h2 id="writing-title">Latest writing</h2><span class="post-count">{posts.length} {posts.length===1?"post":"posts"}</span></div>
{posts.length?<div class="post-list">{posts.map(post=><a class="post-card" href={`${import.meta.env.BASE_URL}posts/${post.id}/`}><div><div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time><span class="meta-dot"></span><span>{Math.max(1,Math.ceil(post.body.split(/\s+/).length/220))} min read</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="post-arrow"><span class="material-symbols-rounded" aria-hidden="true">arrow_outward</span></span></a>)}</div>:<div class="empty-state"><span class="material-symbols-rounded" aria-hidden="true" style="font-size:30px">edit_note</span><p>The first post is brewing. Check back soon.</p></div>}
</section></BaseLayout>
