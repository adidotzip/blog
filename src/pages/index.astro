---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateFormat = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric" });
const getReadingTime = (body) => {
  const readableText = body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]*>/g, " ")
    .replace(/[#>*_~`|]/g, " ");
  const wordCount = readableText.trim().split(/\s+/u).filter(Boolean).length;
  return Math.max(1, Math.ceil(wordCount / 200));
};
---
<BaseLayout description="The latest writing by adi.">
  <section aria-labelledby="writing-title" id="top">
    <h1 class="writing-title" id="writing-title">Latest writings</h1>
    <div class="blog-search">
      <span class="material-symbols-rounded blog-search-icon" aria-hidden="true">search</span>
      <label class="sr-only" for="post-search">Search writings</label>
      <input id="post-search" type="search" placeholder="Search writings" autocomplete="off" spellcheck="false" />
      <kbd class="search-shortcut" aria-hidden="true">/</kbd>
    </div>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    {posts.length ? (
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-card" data-post-card data-search={[
            post.data.title,
            post.data.description,
            ...(post.data.tags || []),
            post.body,
          ].join(" ").toLowerCase()} href={`${import.meta.env.BASE_URL}/posts/${post.id}/`}>
            <div class="post-copy">
              <div class="post-card-meta">
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
                <span class="meta-dot" aria-hidden="true"></span>
                <span>{getReadingTime(post.body)} min read</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
            <span class="post-arrow material-symbols-rounded" aria-hidden="true">arrow_outward</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">No posts yet.</p>
    )}
    <p class="search-empty" id="search-empty" hidden>No writings found. Try another search.</p>
  </section>
  <script>
    const searchInput = document.querySelector("#post-search");
    const postCards = [...document.querySelectorAll("[data-post-card]")];
    const searchStatus = document.querySelector("#search-status");
    const searchEmpty = document.querySelector("#search-empty");

    function filterPosts() {
      const query = searchInput.value.trim().toLocaleLowerCase();
      let visibleCount = 0;

      for (const card of postCards) {
        const matches = !query || card.dataset.search.includes(query);
        card.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      searchEmpty.hidden = !query || visibleCount > 0;
      searchStatus.textContent = query
        ? `${visibleCount} ${visibleCount === 1 ? "result" : "results"}`
        : "";
    }

    searchInput?.addEventListener("input", filterPosts);
    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && !["INPUT", "TEXTAREA"].includes(document.activeElement?.tagName)) {
        event.preventDefault();
        searchInput?.focus();
      }
      if (event.key === "Escape" && document.activeElement === searchInput) {
        searchInput.value = "";
        filterPosts();
        searchInput.blur();
      }
    });
  </script>
</BaseLayout>
