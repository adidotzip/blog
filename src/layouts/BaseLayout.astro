---
import ThemeToggle from "../components/ThemeToggle.svelte";
import "../styles/global.css";
interface Props { title?: string; description?: string }
const { title = "adi's corner", description = "The latest writing by adi." } = Astro.props;
const pageTitle = title === "adi's corner" ? title : `${title} · adi's corner`;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#11062d" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
  <link rel="preconnect" href="https://raw.githubusercontent.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0,0;20..48,500,0,0;20..48,500,1,0&display=swap" rel="stylesheet" />
  <meta name="color-scheme" content="light dark" />
  <title>{pageTitle}</title>
  <script is:inline>{`(() => { try { const saved = localStorage.getItem("theme"); const preferred = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; document.documentElement.dataset.theme = saved || preferred; } catch {} })();`}</script>
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href={`${import.meta.env.BASE_URL}/`} aria-label="adi's corner home">
      <span>adi<span class="wordmark-muted">'s corner</span></span>
    </a>
    <ThemeToggle client:load />
  </header>
  <main><slot /></main>
  <script is:inline>
    document.addEventListener("click", (event) => {
      const summary = event.target instanceof Element
        ? event.target.closest(".article-content details > summary")
        : null;
      if (!summary) return;

      const details = summary.parentElement;
      if (!(details instanceof HTMLDetailsElement)) return;

      if (details.classList.contains("is-closing")) {
        event.preventDefault();
        return;
      }

      if (details.open) {
        event.preventDefault();

        const summaryHeight = summary.getBoundingClientRect().height;
        const compactHeight = Math.ceil(summaryHeight + 28);

        details.style.height = `${details.getBoundingClientRect().height}px`;
        details.classList.add("is-closing");
        details.getBoundingClientRect();

        details.style.height = `${compactHeight}px`;

        const duration = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 260;
        window.setTimeout(() => {
          details.open = false;
          details.classList.remove("is-closing");
          details.style.removeProperty("height");
          details.style.removeProperty("overflow");
        }, duration);
      }
    });
  </script>
</body>
</html>
